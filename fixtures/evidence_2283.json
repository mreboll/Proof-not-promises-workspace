  "change_test": {
    "issue_id": "2283",
    "change_type": "bugfix",
    "test_name": "LedgerIssue2283",
    "test_code": "using System;\nusing System.IO;\nusing System.Linq;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Microsoft.CodeAnalysis;\nusing Microsoft.CodeAnalysis.CSharp;\nusing Microsoft.CodeAnalysis.Diagnostics;\nusing Microsoft.CodeAnalysis.Testing;\nusing MessagePack.SourceGenerator;\nusing MessagePack.SourceGenerator.Analyzers;\nusing Xunit;\n\npublic class LedgerIssue2283\n{\n    [Fact]\n    public async Task ClosedGenericValueTypeFromReferencedAssemblyDoesNotCrashGeneratorOrAnalyzer()\n    {\n        string libSource = \"\"\"\nusing MessagePack;\n\nnamespace Lib;\n\n[MessagePackObject]\npublic partial record struct Item<T>([property: Key(0)] string Key);\n\"\"\";\n\n        string appSource = \"\"\"\nusing MessagePack;\nusing Lib;\n\nnamespace App;\n\n[MessagePackObject]\npublic sealed partial record Cmd([property: Key(0)] string Scope)\n{\n    [Key(1)] public Item<int> Member { get; init; }\n}\n\"\"\";\n\n        var frameworkReferences = await ReferenceAssemblies.Net.Net80.ResolveAsync(LanguageNames.CSharp, CancellationToken.None);\n        var messagePackReferences = ReferencesHelper.GetReferences(ReferencesSet.MessagePack);\n        var libReferences = frameworkReferences.Concat(messagePackReferences).ToArray();\n\n        var libCompilation = CSharpCompilation.Create(\n            \"Lib\",\n            new[] { CSharpSyntaxTree.ParseText(libSource, new CSharpParseOptions(LanguageVersion.Latest)) },\n            libReferences,\n            new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));\n\n        using var libStream = new MemoryStream();\n        var libEmitResult = libCompilation.Emit(libStream);\n        Assert.True(libEmitResult.Success, string.Join(Environment.NewLine, libEmitResult.Diagnostics.Select(d => d.ToString())));\n        libStream.Seek(0, SeekOrigin.Begin);\n        var libReference = MetadataReference.CreateFromImage(libStream.ToArray());\n\n        var appReferences = frameworkReferences.Concat(messagePackReferences).Concat(new[] { libReference }).ToArray();\n\n        var appCompilation = CSharpCompilation.Create(\n            \"App\",\n            new[] { CSharpSyntaxTree.ParseText(appSource, new CSharpParseOptions(LanguageVersion.Latest)) },\n            appReferences,\n            new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));\n\n        var driver = CSharpGeneratorDriver.Create(new MessagePackGenerator().AsSourceGenerator());\n        GeneratorDriverRunResult runResult = driver.RunGeneratorsAndUpdateCompilation(appCompilation, out var outputCompilation, out var generatorDiagnostics).GetRunResult();\n\n        var generatorExceptions = runResult.Results.Where(r => r.Exception != null).ToArray();\n        Assert.Empty(generatorExceptions);\n\n        var generatorErrors = runResult.Diagnostics.Where(d => d.Severity == DiagnosticSeverity.Error).ToArray();\n        Assert.Empty(generatorErrors);\n\n        var analyzerDiagnostics = await appCompilation\n            .WithAnalyzers(ImmutableArray.Create<DiagnosticAnalyzer>(new MsgPack00xMessagePackAnalyzer()))\n            .GetAnalyzerDiagnosticsAsync();\n\n        var analyzerCrashes = analyzerDiagnostics.Where(d => d.Id == \"AD0001\").ToArray();\n        Assert.Empty(analyzerCrashes);\n\n        var generatedSources = runResult.Results.SelectMany(r => r.GeneratedSources).ToArray();\n        Assert.NotEmpty(generatedSources);\n    }\n}",
