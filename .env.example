# Copy this file to .env and fill in your keys. .env is git-ignored. Everyone uses their OWN keys.

# --- Gemini (bounty "Best Use of Gemini API"): change test, Defender, mutants and scope triage
# gemini-2.5-* is no longer available to new API keys; these are the models we ran with.
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-4-hydrogen
GEMINI_MODEL_FLASH=gemini-3.8-flash

# --- NVIDIA Nemotron (bounty "Best Use of Nemotron"): the Prosecutor
# Free key at build.nvidia.com (about 40 requests per minute per key).
NVIDIA_API_KEY=
# Required for the bounty: Nemotron 3.5 Super VL (ID checked against the integrate.api.nvidia.com catalog).
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Fast model for the "flash" role, only used when LEDGER_NVIDIA_FOR_ALL=1.
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# 1 = route "pro" and "flash" to Nemotron too (fallback without Gemini). Keep 0: the Prosecutor (Nemotron) and the
# Defender (Gemini) must come from different model families (decision D7).
LEDGER_NVIDIA_FOR_ALL=0

# --- Modal (bounty "Best use of Modal"): network-less sandboxes for AI-written tests
# Configure with `modal token new` (stored in ~/.modal.toml, not here).
# LEDGER_RUNNER=local | modal
LEDGER_RUNNER=local

# --- Concurrency (only used with LEDGER_RUNNER=modal: the local runner always runs sequentially,
# because parallel runs on the same worktree would overwrite each other)
# High-risk files cross-examined at the same time; each file runs its objections in parallel too.
LEDGER_CROSSEXAM_WORKERS=12
# Simultaneous Modal Sandboxes. The Starter plan allows 100 containers; raise it on bigger plans.
LEDGER_MODAL_MAX_SANDBOXES=60
# Simultaneous requests per LLM provider. Raise Gemini only while you see no 429 (rate limit) errors.
LEDGER_MAX_CONCURRENT_GEMINI=8
LEDGER_MAX_CONCURRENT_NVIDIA=8

# Path to the junction26-messagepack-csharp clone (relative to this repo or absolute).
MSGPACK_REPO=../junction26-messagepack-csharp
