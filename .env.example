# Copia este fichero a .env y rellena las claves. .env está en .gitignore. Cada persona usa SUS claves.

# --- Gemini (bounty "Best Use of Gemini API"): test independiente, Defensor, mutantes y triaje
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash

# --- NVIDIA Nemotron (bounty "Best Use of Nemotron"): el Fiscal
# Clave gratuita en build.nvidia.com (unas 40 peticiones por minuto por clave).
NVIDIA_API_KEY=
# OBLIGATORIO para el bounty: el ID exacto de "Nemotron 3.5 Super VL" tal como aparece en build.nvidia.com.
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Modal (bounty "Best use of Modal"): sandboxes para ejecutar los tests generados por IA
# Se configura con `modal token new` (queda en ~/.modal.toml, no aquí).
# LEDGER_RUNNER=local | modal
LEDGER_RUNNER=local

# Ruta al clon de junction26-messagepack-csharp (relativa a este repo o absoluta).
MSGPACK_REPO=../junction26-messagepack-csharp
